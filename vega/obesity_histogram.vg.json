{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Histogram showing the distribution of obesity percentages across age and gender groups.",
  "title": "Distribution of obesity rates across age and gender groups",
  "width": "container",
  "height": 320,
  "data": {"url": "../data/obesity_gender.csv"},
  "mark": {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3},
  "encoding": {
    "x": {
      "field": "obesity_percent",
      "type": "quantitative",
      "bin": {"step": 5},
      "title": "Adults obese (%)"
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of age-gender groups"
    },
    "color": {"value": "#2f8fc2"},
    "tooltip": [
      {"field": "obesity_percent", "type": "quantitative", "bin": {"step": 5}, "title": "Obesity bin (%)"},
      {"aggregate": "count", "type": "quantitative", "title": "Groups"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "gridColor": "#dcecf5"}
  }
}
