{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Binned matrix showing how states cluster by physical activity and obesity rates.",
  "title": "Binned activity-obesity matrix by state and territory",
  "width": "container",
  "height": 340,
  "data": {"url": "../data/activity_obesity_bins.csv"},
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 8, "stroke": "#ffffff", "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "activity_bin",
          "type": "ordinal",
          "title": "People meeting physical activity guidelines (%)",
          "sort": ["20-22%", "22-24%", "24-26%"]
        },
        "y": {
          "field": "obesity_bin",
          "type": "ordinal",
          "title": "Adults obese (%)",
          "sort": ["36-38%", "32-36%", "28-32%"]
        },
        "color": {
          "field": "states_in_bin",
          "type": "quantitative",
          "title": "States in bin",
          "scale": {"range": ["#eef7fb", "#41b6c4", "#0f4c75"], "domain": [0, 2]}
        },
        "tooltip": [
          {"field": "activity_bin", "type": "ordinal", "title": "Activity bin"},
          {"field": "obesity_bin", "type": "ordinal", "title": "Obesity bin"},
          {"field": "states_in_bin", "type": "quantitative", "title": "States/territories"},
          {"field": "state_list", "type": "nominal", "title": "States"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.states_in_bin > 0"}],
      "mark": {"type": "circle", "filled": true, "opacity": 0.86, "stroke": "#ffffff", "strokeWidth": 1.2},
      "encoding": {
        "x": {
          "field": "activity_bin",
          "type": "ordinal",
          "sort": ["20-22%", "22-24%", "24-26%"]
        },
        "y": {
          "field": "obesity_bin",
          "type": "ordinal",
          "sort": ["36-38%", "32-36%", "28-32%"]
        },
        "size": {
          "field": "states_in_bin",
          "type": "quantitative",
          "title": "States in bin",
          "scale": {"range": [600, 2200], "domain": [1, 2]}
        },
        "color": {"value": "#0f4c75"},
        "tooltip": [
          {"field": "activity_bin", "type": "ordinal", "title": "Activity bin"},
          {"field": "obesity_bin", "type": "ordinal", "title": "Obesity bin"},
          {"field": "states_in_bin", "type": "quantitative", "title": "States/territories"},
          {"field": "state_list", "type": "nominal", "title": "States"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "#183242"},
      "encoding": {
        "x": {
          "field": "activity_bin",
          "type": "ordinal",
          "sort": ["20-22%", "22-24%", "24-26%"]
        },
        "y": {
          "field": "obesity_bin",
          "type": "ordinal",
          "sort": ["36-38%", "32-36%", "28-32%"]
        },
        "text": {"field": "states_in_bin", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "gridColor": "#dcecf5"},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
