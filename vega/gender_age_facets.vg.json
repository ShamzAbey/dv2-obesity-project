{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Node-link diagram showing adult obesity by gender and age group using ABS NHS 2022 BMI proportions.",
  "title": "Node-link diagram of adult obesity by gender and age group, 2022",
  "width": "container",
  "height": 380,
  "layer": [
    {
      "data": {"url": "../data/demographic_node_link_edges.csv"},
      "mark": {"type": "rule", "strokeWidth": 2.2, "opacity": 0.45},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [100, 0]}, "axis": null},
        "y2": {"field": "y2"},
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {"range": ["#2a7fb8", "#9bd7ea"]}
        },
        "tooltip": [
          {"field": "source", "type": "nominal", "title": "From"},
          {"field": "target", "type": "nominal", "title": "To"}
        ]
      }
    },
    {
      "data": {"url": "../data/demographic_node_link_nodes.csv"},
      "transform": [{"filter": "datum.node_type != 'Age group'"}],
      "mark": {"type": "circle", "filled": true, "size": 980, "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [100, 0]}, "axis": null},
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {"range": ["#0f4c75", "#2a7fb8", "#9bd7ea"]}
        },
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Node"},
          {"field": "node_type", "type": "nominal", "title": "Type"}
        ]
      }
    },
    {
      "data": {"url": "../data/demographic_node_link_nodes.csv"},
      "transform": [{"filter": "datum.node_type == 'Age group'"}],
      "mark": {"type": "circle", "filled": true, "stroke": "#ffffff", "strokeWidth": 1.4, "opacity": 0.94},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [100, 0]}, "axis": null},
        "size": {
          "field": "overweight_obese_percent",
          "type": "quantitative",
          "title": "Overweight/obese (%)",
          "scale": {"range": [260, 1050]},
          "legend": {"orient": "right"}
        },
        "color": {
          "field": "obesity_percent",
          "type": "quantitative",
          "title": "Adults obese (%)",
          "scale": {"range": ["#d8eef7", "#41b6c4", "#0f4c75"], "domain": [14, 27, 40]}
        },
        "tooltip": [
          {"field": "group", "type": "nominal", "title": "Gender"},
          {"field": "label", "type": "nominal", "title": "Age group"},
          {"field": "obesity_percent", "type": "quantitative", "title": "Obese (%)", "format": ".1f"},
          {"field": "overweight_obese_percent", "type": "quantitative", "title": "Overweight/obese (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"url": "../data/demographic_node_link_nodes.csv"},
      "mark": {"type": "text", "align": "left", "dx": 13, "fontSize": 12, "fontWeight": "bold", "color": "#183242"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [100, 0]}, "axis": null},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {"url": "../data/demographic_node_link_nodes.csv"},
      "transform": [{"filter": "datum.node_type == 'Age group'"}],
      "mark": {"type": "text", "align": "left", "dx": 57, "fontSize": 11, "color": "#5d6f7d"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [100, 0]}, "axis": null},
        "text": {"field": "obesity_percent", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
