{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "State and territory adult obesity distribution boxplot using ABS NHS 2022 state findings, with labelled state points.",
  "title": "Distribution of adult obesity rates across Australian states and territories",
  "width": "container",
  "height": 310,
  "data": {"url": "../data/obesity_state.csv"},
  "transform": [
    {"calculate": "'States and territories'", "as": "distribution"},
    {
      "lookup": "state",
      "from": {
        "data": {"url": "../data/physical_activity.csv"},
        "key": "state",
        "fields": ["population_thousands", "met_guidelines_percent"]
      }
    },
    {
      "calculate": "datum.state == 'Tas' || datum.state == 'ACT' || datum.state == 'Qld' ? datum.state : ''",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 78,
        "median": {"color": "#0f4c75", "strokeWidth": 3},
        "ticks": {"color": "#0f4c75"},
        "rule": {"color": "#7abed9"},
        "box": {"fill": "#9bd7ea", "stroke": "#2f8fc2", "fillOpacity": 0.72}
      },
      "encoding": {
        "x": {
          "field": "distribution",
          "type": "nominal",
          "title": null,
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "obese_percent",
          "type": "quantitative",
          "title": "Adults obese (%)",
          "scale": {"domain": [28, 38]}
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.9,
        "size": 115,
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {"field": "distribution", "type": "nominal"},
        "y": {"field": "obese_percent", "type": "quantitative"},
        "xOffset": {"field": "state", "type": "nominal"},
        "color": {
          "field": "obese_percent",
          "type": "quantitative",
          "title": "Adults obese (%)",
          "scale": {"range": ["#d8eef7", "#41b6c4", "#0f4c75"], "domain": [28, 33, 38]}
        },
        "tooltip": [
          {"field": "state_full", "type": "nominal", "title": "State/territory"},
          {"field": "obese_percent", "type": "quantitative", "title": "Obese (%)", "format": ".1f"},
          {"field": "overweight_obese_percent", "type": "quantitative", "title": "Overweight/obese (%)", "format": ".1f"},
          {"field": "met_guidelines_percent", "type": "quantitative", "title": "Met activity guidelines (%)", "format": ".1f"},
          {"field": "population_thousands", "type": "quantitative", "title": "Population ('000)", "format": ",.1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.label != ''"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "dy": -8, "fontWeight": "bold", "color": "#183242"},
      "encoding": {
        "x": {"field": "distribution", "type": "nominal"},
        "y": {"field": "obese_percent", "type": "quantitative"},
        "xOffset": {"field": "state", "type": "nominal"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "mean", "field": "obese_percent", "as": "mean_obesity"}
          ]
        }
      ],
      "mark": {"type": "rule", "stroke": "#0f4c75", "strokeDash": [5, 4], "strokeWidth": 2},
      "encoding": {
        "y": {"field": "mean_obesity", "type": "quantitative"},
        "tooltip": [
          {"field": "mean_obesity", "type": "quantitative", "title": "Mean obese (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "gridColor": "#dcecf5"},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
