{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart of latest selected beverage apparent consumption by category from ABS 2023-24 data.",
  "title": "Latest selected beverage consumption share, 2023-24",
  "data": {"url": "../data/food_consumption.csv"},
  "transform": [{"filter": "datum.year == '2023-24'"}],
  "width": "container",
  "height": 300,
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 82, "outerRadius": 145, "stroke": "#ffffff", "strokeWidth": 1},
      "encoding": {
        "theta": {
          "field": "ml_per_capita_per_day",
          "type": "quantitative",
          "title": "mL per capita per day",
          "stack": true
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Category",
          "scale": {"range": ["#0f4c75", "#2a7fb8", "#2f8fc2", "#41b6c4", "#9bd7ea", "#1d6fa5", "#6db8d7"]},
          "legend": {"orient": "bottom", "columns": 2}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Financial year"},
          {"field": "category", "type": "nominal", "title": "Category"},
          {"field": "ml_per_capita_per_day", "type": "quantitative", "title": "mL per capita per day", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "sum", "field": "ml_per_capita_per_day", "as": "total_ml"}
          ]
        }
      ],
      "mark": {"type": "text", "fontSize": 24, "fontWeight": "bold", "color": "#0f4c75"},
      "encoding": {
        "text": {"field": "total_ml", "type": "quantitative", "format": ".0f"}
      }
    },
    {
      "mark": {"type": "text", "dy": 25, "fontSize": 12, "color": "#5d6f7d"},
      "encoding": {"text": {"value": "mL/capita/day"}}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 10, "titleFontSize": 11}
  }
}
