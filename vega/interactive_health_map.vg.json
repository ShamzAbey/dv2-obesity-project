{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive choropleth map of adult obesity using ABS state and territory findings, with zoom and map-centre controls.",
  "title": "Adult obesity rate by state and territory",
  "width": "container",
  "height": 460,
  "params": [
    {
      "name": "mapScale",
      "value": 1150,
      "bind": {
        "input": "range",
        "name": "Zoom: ",
        "min": 850,
        "max": 2200,
        "step": 50
      }
    },
    {
      "name": "mapCenter",
      "value": [134, -27],
      "bind": {
        "input": "select",
        "name": "Map centre: ",
        "options": [
          [134, -27],
          [151.2, -33.9],
          [144.9, -37.8],
          [147.3, -42.0],
          [130.8, -12.5],
          [115.9, -31.9]
        ],
        "labels": [
          "Australia",
          "NSW/ACT",
          "Victoria",
          "Tasmania",
          "Northern Territory",
          "Western Australia"
        ]
      }
    }
  ],
  "data": {
    "url": "../data/australia_states.topojson",
    "format": {"type": "topojson", "feature": "collection"}
  },
  "transform": [
    {"calculate": "toNumber(datum.properties.STATE)", "as": "state_code"},
    {
      "lookup": "state_code",
      "from": {
        "data": {"url": "../data/obesity_state.csv"},
        "key": "state_code",
        "fields": ["state", "state_full", "obese_percent", "overweight_obese_percent"]
      }
    },
    {"filter": "isValid(datum.obese_percent)"}
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "mapCenter"},
    "scale": {"expr": "mapScale"}
  },
  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.7},
  "encoding": {
    "color": {
      "field": "obese_percent",
      "type": "quantitative",
      "title": "Adults obese (%)",
      "scale": {"range": ["#e4f3fb", "#41b6c4", "#0f4c75"], "domain": [28, 33, 38]}
    },
    "tooltip": [
      {"field": "state_full", "type": "nominal", "title": "State/territory"},
      {"field": "obese_percent", "type": "quantitative", "title": "Obese (%)", "format": ".1f"},
      {"field": "overweight_obese_percent", "type": "quantitative", "title": "Overweight/obese (%)", "format": ".1f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12},
    "legend": {"labelFontSize": 12, "titleFontSize": 12}
  }
}
