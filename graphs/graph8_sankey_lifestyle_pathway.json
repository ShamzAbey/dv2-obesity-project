{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Sankey-style alluvial flow showing state counts through measured lifestyle categories: sugary drinks, fruit recommendation achievement, physical activity and obesity.",
  "title": {
    "text": "Sankey-style lifestyle pathway",
    "subtitle": "State counts through sugary drinks, diet quality, activity and obesity categories"
  },
  "width": "container",
  "height": 390,
  "layer": [
    {
      "data": {"url": "../data/datasets/lifestyle_pathway_links.csv"},
      "mark": {"type": "rule", "opacity": 0.48, "strokeCap": "round"},
      "encoding": {
        "x": {"field": "source_x", "type": "quantitative", "scale": {"domain": [0, 1]}, "axis": null},
        "x2": {"field": "target_x"},
        "y": {"field": "source_y", "type": "quantitative", "scale": {"domain": [0, 9]}, "axis": null},
        "y2": {"field": "target_y"},
        "strokeWidth": {"field": "count", "type": "quantitative", "legend": null, "scale": {"range": [8, 30]}},
        "color": {"field": "source", "type": "nominal", "legend": null, "scale": {"range": ["#0f4c75", "#2f8fc2", "#41b6c4", "#9bd7ea", "#1d6fa5", "#5d6f7d"]}},
        "tooltip": [
          {"field": "source", "type": "nominal", "title": "From"},
          {"field": "target", "type": "nominal", "title": "To"},
          {"field": "count", "type": "quantitative", "title": "States/territories"},
          {"field": "states", "type": "nominal", "title": "States"}
        ]
      }
    },
    {
      "data": {"url": "../data/datasets/lifestyle_pathway_nodes.csv"},
      "mark": {"type": "rect", "cornerRadius": 6, "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "x0", "type": "quantitative", "scale": {"domain": [0, 1]}, "axis": null},
        "x2": {"field": "x1"},
        "y": {"field": "y0", "type": "quantitative", "scale": {"domain": [0, 9]}, "axis": null},
        "y2": {"field": "y1"},
        "color": {"field": "stage", "type": "nominal", "legend": null, "scale": {"range": ["#0f4c75", "#2f8fc2", "#41b6c4", "#1d6fa5"]}},
        "tooltip": [
          {"field": "stage", "type": "nominal", "title": "Stage"},
          {"field": "node", "type": "nominal", "title": "Category"},
          {"field": "count", "type": "quantitative", "title": "States/territories"}
        ]
      }
    },
    {
      "data": {"url": "../data/datasets/lifestyle_pathway_nodes.csv"},
      "mark": {"type": "text", "align": "center", "fontSize": 11, "fontWeight": "bold", "color": "#ffffff", "lineBreak": "|", "lineHeight": 13},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 1]}, "axis": null},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [0, 9]}, "axis": null},
        "text": {"field": "node", "type": "nominal"}
      }
    },
    {
      "data": {"url": "../data/datasets/lifestyle_pathway_nodes.csv"},
      "mark": {"type": "text", "align": "center", "dy": 24, "fontSize": 11, "fontWeight": "bold", "color": "#eaf8fc"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 1]}, "axis": null},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [0, 9]}, "axis": null},
        "text": {"field": "count", "type": "quantitative"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
