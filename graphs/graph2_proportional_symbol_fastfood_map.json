{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map using real ABS daily sugar-sweetened drink consumption as the available unhealthy food/drink geography measure. Direct state fast-food consumption data is not available in the sourced public tables.",
  "title": {
    "text": "Unhealthy drink geography across Australia",
    "subtitle": "Circle size shows daily sugar-sweetened drink consumption; colour shows adult obesity"
  },
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "sexChoice",
      "value": "Men",
      "bind": {"input": "select", "name": "Daily consumption for: ", "options": ["Men", "Women"]}
    },
    {
      "name": "stateSelect",
      "select": {"type": "point", "fields": ["state"]},
      "bind": "legend"
    }
  ],
  "projection": {"type": "mercator", "center": [134, -28], "scale": 1050},
  "layer": [
    {
      "data": {
        "url": "../data/datasets/australia_states.topojson",
        "format": {"type": "topojson", "feature": "australia_states"}
      },
      "mark": {"type": "geoshape", "fill": "#e3f2f9", "stroke": "#ffffff", "strokeWidth": 1.3}
    },
    {
      "data": {"url": "../data/datasets/sugar_sweetened_state_2017.csv"},
      "transform": [
        {"filter": "datum.sex == sexChoice"},
        {
          "lookup": "state",
          "from": {
            "data": {"url": "../data/datasets/state_locations.csv"},
            "key": "state",
            "fields": ["longitude", "latitude"]
          }
        }
      ],
      "mark": {"type": "circle", "filled": true, "strokeWidth": 2.4},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "sugar_sweetened_daily_percent",
          "type": "quantitative",
          "title": "Consumed daily (%)",
          "scale": {"range": [180, 2300], "domain": [3, 16]}
        },
        "color": {
          "field": "obesity_percent",
          "type": "quantitative",
          "title": "Adults obese (%)",
          "scale": {"scheme": "blues", "domain": [29, 38]}
        },
        "stroke": {
          "field": "state",
          "type": "nominal",
          "title": "State/territory",
          "scale": {"range": ["#0f4c75", "#1d6fa5", "#2f8fc2", "#41b6c4", "#6db8d7", "#2a7fb8", "#9bd7ea", "#5d6f7d"]}
        },
        "opacity": {"condition": {"param": "stateSelect", "value": 0.95}, "value": 0.25},
        "tooltip": [
          {"field": "state_full", "type": "nominal", "title": "State/territory"},
          {"field": "sex", "type": "nominal", "title": "Sex"},
          {"field": "sugar_sweetened_daily_percent", "type": "quantitative", "title": "Sugar-sweetened drinks daily (%)", "format": ".1f"},
          {"field": "obesity_percent", "type": "quantitative", "title": "Adults obese (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"url": "../data/datasets/sugar_sweetened_state_2017.csv"},
      "transform": [
        {"filter": "datum.sex == sexChoice"},
        {
          "lookup": "state",
          "from": {
            "data": {"url": "../data/datasets/state_locations.csv"},
            "key": "state",
            "fields": ["longitude", "latitude"]
          }
        }
      ],
      "mark": {"type": "text", "dy": -18, "fontWeight": "bold", "color": "#183242"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
