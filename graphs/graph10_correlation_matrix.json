{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Correlation matrix showing state-level relationships between obesity, income, sugary drinks, inactivity, fruit and vegetable recommendation rates.",
  "title": {
    "text": "Correlation matrix: obesity and lifestyle factors",
    "subtitle": "State-level correlations across real ABS-derived variables"
  },
  "width": "container",
  "height": 430,
  "data": {"url": "../data/datasets/correlation_matrix.csv"},
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 4},
      "encoding": {
        "x": {"field": "var_x", "type": "ordinal", "title": null},
        "y": {"field": "var_y", "type": "ordinal", "title": null},
        "color": {"field": "correlation", "type": "quantitative", "title": "Correlation", "scale": {"scheme": "redblue", "domain": [-1, 1]}},
        "tooltip": [
          {"field": "var_x", "type": "nominal", "title": "Variable X"},
          {"field": "var_y", "type": "nominal", "title": "Variable Y"},
          {"field": "correlation", "type": "quantitative", "title": "Correlation", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontWeight": "bold", "fontSize": 12},
      "encoding": {
        "x": {"field": "var_x", "type": "ordinal"},
        "y": {"field": "var_y", "type": "ordinal"},
        "text": {"field": "correlation", "type": "quantitative", "format": ".2f"},
        "color": {"condition": {"test": "abs(datum.correlation) > 0.62", "value": "#ffffff"}, "value": "#183242"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "labelAngle": -30},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
