{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Overview and detail time series with brushing and legend selection for ABS selected beverage consumption.",
  "title": "Overview + detail: selected beverage consumption over time",
  "data": {"url": "../data/datasets/food_consumption.csv"},
  "params": [
    {"name": "categorySelect", "select": {"type": "point", "fields": ["category"]}, "bind": "legend"}
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 310,
      "transform": [
        {"filter": {"param": "yearBrush"}},
        {"filter": {"param": "categorySelect"}}
      ],
      "mark": {"type": "line", "point": {"filled": true, "size": 56}, "strokeWidth": 3},
      "encoding": {
        "x": {"field": "year_start", "type": "quantitative", "title": "Financial year beginning", "axis": {"format": "d", "tickMinStep": 1}},
        "y": {"field": "ml_per_capita_per_day", "type": "quantitative", "title": "mL per capita per day"},
        "color": {"field": "category", "type": "nominal", "title": "Category", "scale": {"range": ["#0f4c75", "#1d6fa5", "#2f8fc2", "#41b6c4", "#9bd7ea", "#2a7fb8", "#6db8d7"]}},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Financial year"},
          {"field": "category", "type": "nominal", "title": "Category"},
          {"field": "ml_per_capita_per_day", "type": "quantitative", "title": "mL per capita per day", "format": ".1f"}
        ]
      }
    },
    {
      "width": "container",
      "height": 86,
      "params": [{"name": "yearBrush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "area", "line": {"color": "#0f4c75", "strokeWidth": 2}, "color": "#9bd7ea", "opacity": 0.75},
      "encoding": {
        "x": {"field": "year_start", "type": "quantitative", "title": "Brush to filter the detailed chart", "axis": {"format": "d", "tickMinStep": 1}},
        "y": {"field": "ml_per_capita_per_day", "aggregate": "sum", "type": "quantitative", "title": "Total"},
        "tooltip": [
          {"field": "year_start", "type": "quantitative", "title": "Year", "format": "d"},
          {"aggregate": "sum", "field": "ml_per_capita_per_day", "type": "quantitative", "title": "Total mL/day", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "#cfe3ef"},
    "axis": {"gridColor": "#d9edf7", "labelFontSize": 12, "titleFontSize": 12},
    "legend": {"orient": "bottom", "labelFontSize": 11, "titleFontSize": 12}
  }
}
