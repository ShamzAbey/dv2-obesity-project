{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map showing adult obesity rates by Australian state and territory using TopoJSON and ABS NHS 2022 state findings.",
  "title": {
    "text": "Adult obesity rates by state and territory",
    "subtitle": "Colour luminance encodes the percentage of adults classified as obese"
  },
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "focusState",
      "value": "All",
      "bind": {"input": "select", "name": "State filter: ", "options": ["All", "ACT", "NSW", "NT", "Qld", "SA", "Tas", "Vic", "WA"]}
    },
    {"name": "mapScale", "value": 1050, "bind": {"input": "range", "name": "Zoom: ", "min": 850, "max": 1700, "step": 25}},
    {"name": "panX", "value": 420, "bind": {"input": "range", "name": "Pan X: ", "min": 280, "max": 620, "step": 5}},
    {"name": "panY", "value": 270, "bind": {"input": "range", "name": "Pan Y: ", "min": 120, "max": 430, "step": 5}}
  ],
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": {"expr": "mapScale"},
    "translate": [{"expr": "panX"}, {"expr": "panY"}]
  },
  "data": {
    "url": "../data/datasets/australia_states.topojson",
    "format": {"type": "topojson", "feature": "australia_states"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_CODE",
      "from": {
        "data": {"url": "../data/datasets/obesity_state.csv"},
        "key": "state_code",
        "fields": ["state", "state_full", "obese_percent", "overweight_percent", "overweight_obese_percent"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.3},
  "encoding": {
    "color": {
      "field": "obese_percent",
      "type": "quantitative",
      "title": "Adults obese (%)",
      "scale": {"scheme": "blues", "domain": [29, 38]}
    },
    "opacity": {"condition": {"test": "focusState == 'All' || datum.state == focusState", "value": 1}, "value": 0.22},
    "tooltip": [
      {"field": "state_full", "type": "nominal", "title": "State/territory"},
      {"field": "obese_percent", "type": "quantitative", "title": "Adults obese (%)", "format": ".1f"},
      {"field": "overweight_percent", "type": "quantitative", "title": "Adults overweight (%)", "format": ".1f"},
      {"field": "overweight_obese_percent", "type": "quantitative", "title": "Overweight or obese (%)", "format": ".1f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFontSize": 12, "titleFontSize": 12}
  }
}
