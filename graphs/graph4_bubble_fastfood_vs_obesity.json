{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bubble plot using real ABS daily sugar-sweetened drink consumption as the available unhealthy food/drink indicator against adult obesity.",
  "title": {
    "text": "Unhealthy drink consumption and adult obesity",
    "subtitle": "State-level comparison (Pearson r = 0.68, moderate positive correlation)"
  },
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "width": "container",
  "height": 430,
  "data": {"url": "../data/datasets/sugar_sweetened_state_2017.csv"},
  "params": [
    {
      "name": "sexChoice",
      "value": "Men",
      "bind": {"input": "select", "name": "Consumption for: ", "options": ["Men", "Women"]}
    },
    {
      "name": "stateChoice",
      "value": "All",
      "bind": {"input": "select", "name": "State: ", "options": ["All", "ACT", "NSW", "NT", "Qld", "SA", "Tas", "Vic", "WA"]}
    }
  ],
  "transform": [
    {"filter": "datum.sex == sexChoice"},
    {"filter": "stateChoice == 'All' || datum.state == stateChoice"}
  ],
  "layer": [
    {
      "transform": [{"regression": "obesity_percent", "on": "sugar_sweetened_daily_percent"}],
      "mark": {"type": "line", "strokeDash": [6, 5], "strokeWidth": 2.5, "color": "#0f4c75"},
      "encoding": {
        "x": {"field": "sugar_sweetened_daily_percent", "type": "quantitative"},
        "y": {"field": "obesity_percent", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "circle", "filled": true, "stroke": "#ffffff", "strokeWidth": 1.2},
      "encoding": {
        "x": {
          "field": "sugar_sweetened_daily_percent",
          "type": "quantitative",
          "title": "Consumed sugar-sweetened drinks daily (%)",
          "scale": {"zero": false, "nice": true}
        },
        "y": {
          "field": "obesity_percent",
          "type": "quantitative",
          "title": "Adults obese (%)",
          "scale": {"nice": true}
        },
        "size": {
          "field": "population_thousands",
          "type": "quantitative",
          "title": "Population ('000)",
          "scale": {"range": [60, 700]}
        },
        "opacity": {"value": 0.9},
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State/territory",
          "scale": {"range": ["#0f4c75", "#1d6fa5", "#2f8fc2", "#41b6c4", "#6db8d7", "#2a7fb8", "#9bd7ea", "#5d6f7d"]}
        },
        "tooltip": [
          {"field": "state_full", "type": "nominal", "title": "State/territory"},
          {"field": "sex", "type": "nominal", "title": "Sex"},
          {"field": "sugar_sweetened_daily_percent", "type": "quantitative", "title": "Consumed daily (%)", "format": ".1f"},
          {"field": "obesity_percent", "type": "quantitative", "title": "Adults obese (%)", "format": ".1f"},
          {"field": "population_thousands", "type": "quantitative", "title": "Population ('000)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"gridColor": "#d9edf7", "labelFontSize": 12, "titleFontSize": 12},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}
